{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Estado operacional legivel da rodada do Analista",
  "type": "object",
  "required": ["schemaVersion", "rodada", "status", "entrada", "progresso", "achados", "confrontos", "decisoes", "problemas", "proposta"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "rodada": { "type": "string", "minLength": 1 },
    "status": { "enum": ["PREPARANDO", "LENDO_REFERENCIAS", "ORGANIZANDO_ACHADOS", "AGUARDANDO_DECISAO_DO_DESIGNER", "PRONTO_PARA_REVISAO", "BLOQUEADO_TECNICAMENTE"] },
    "entrada": {
      "type": "object",
      "required": ["figmaUrl", "sections", "contextoCurto"],
      "properties": {
        "figmaUrl": { "type": "string", "minLength": 1 },
        "sections": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "contextoCurto": { "type": ["string", "null"] }
      }
    },
    "progresso": {
      "type": "object",
      "required": ["sections"],
      "properties": {
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["nome", "status"],
            "properties": {
              "nome": { "type": "string", "minLength": 1 },
              "status": { "enum": ["PENDENTE", "LENDO", "CONCLUIDA", "NAO_ENCONTRADA", "FALHOU"] },
              "estrutura": { "type": ["object", "null"] },
              "interacoes": { "type": ["object", "null"] }
            }
          }
        }
      }
    },
    "achados": { "type": "array", "items": { "type": "object", "required": ["tipo", "titulo", "descricao"], "properties": { "tipo": { "enum": ["FATO", "HIPOTESE", "RISCO"] }, "titulo": { "type": "string", "minLength": 1 }, "descricao": { "type": "string", "minLength": 1 } } } },
    "confrontos": { "type": "array", "items": { "type": "object", "required": ["id", "topico", "observacao", "situacaoBase", "fontesBase", "conclusao"], "properties": { "id": { "type": "string", "minLength": 1 }, "topico": { "type": "string", "minLength": 1 }, "observacao": { "type": "string", "minLength": 1 }, "situacaoBase": { "enum": ["DOCUMENTADO", "DIVERGENTE", "SEM_BASE"] }, "fontesBase": { "type": "array", "items": { "type": "string" } }, "conclusao": { "type": "string", "minLength": 1 } } } },
    "decisoes": { "type": "array", "maxItems": 3, "items": { "type": "object", "required": ["id", "pergunta", "impacto", "recomendacao", "status"], "properties": { "id": { "type": "string", "minLength": 1 }, "pergunta": { "type": "string", "minLength": 1 }, "impacto": { "type": "string", "minLength": 1 }, "recomendacao": { "type": "string", "minLength": 1 }, "status": { "enum": ["PENDENTE", "RESPONDIDA"] } } } },
    "problemas": { "type": "array", "items": { "type": "object", "required": ["codigo", "mensagemHumana", "responsavel", "proximaAcao", "bloqueia"], "properties": { "codigo": { "type": "string", "minLength": 1 }, "mensagemHumana": { "type": "string", "minLength": 1 }, "responsavel": { "enum": ["ANALISTA", "DESIGNER", "FERRAMENTA"] }, "proximaAcao": { "type": "string", "minLength": 1 }, "bloqueia": { "type": "boolean" } } } },
    "proposta": { "type": "object", "required": ["status", "entregaveis"], "properties": { "status": { "enum": ["NAO_INICIADA", "EM_PREPARACAO", "PRONTA"] }, "entregaveis": { "type": "array", "items": { "type": "string" } }, "resumo": { "type": ["string", "null"] } } }
  }
}
