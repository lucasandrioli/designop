{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pacote de verificacao da composicao de uma etapa",
  "type": "object",
  "required": ["schemaVersion", "rodada", "modalidade", "etapa", "estado", "momentosPromovidos", "contratoComposicao", "prototipo", "evidenciaMontagem", "veredito", "semPromocao"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "rodada": { "type": "string" },
    "modalidade": { "type": "string" },
    "etapa": { "type": "string" },
    "estado": { "const": "PRONTA_PARA_VERIFICACAO" },
    "momentosPromovidos": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/momentoPromovido" } },
    "contratoComposicao": { "$ref": "#/$defs/artefato" },
    "prototipo": { "$ref": "#/$defs/artefato" },
    "evidenciaMontagem": { "$ref": "#/$defs/artefato" },
    "veredito": { "$ref": "#/$defs/artefato" },
    "semPromocao": { "const": true }
  },
  "$defs": {
    "artefato": { "type": "object", "required": ["caminho", "sha256"], "properties": { "caminho": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } },
    "momentoPromovido": {
      "type": "object",
      "required": ["rodada", "promocao"],
      "properties": {
        "rodada": { "type": "string", "minLength": 1 },
        "promocao": { "$ref": "#/$defs/artefato" }
      }
    }
  }
}
