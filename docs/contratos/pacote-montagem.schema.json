{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pacote verificavel de montagem da rodada",
  "type": "object",
  "required": ["schemaVersion", "rodada", "estado", "topologia", "areaVerificacao", "escopoMomento", "contratoMomento", "alvos", "componentesLocais", "planoVariaveis"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "rodada": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "estado": { "const": "CONCLUIDA_PARA_VALIDACAO" },
    "topologia": {
      "type": "object",
      "required": ["arquivo", "sha256"],
      "properties": {
        "arquivo": { "const": "docs/topologia-biblioteca.md" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "areaVerificacao": {
      "type": "object",
      "required": ["nome", "confirmada", "evidencia"],
      "properties": {
        "nome": { "type": "string", "pattern": "^_verificacao-[a-z0-9-]+$" },
        "confirmada": { "const": true },
        "evidencia": { "$ref": "#/$defs/artefato" }
      }
    },
    "escopoMomento": { "$ref": "#/$defs/artefato" },
    "contratoMomento": { "$ref": "#/$defs/artefato" },
    "alvos": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["modalidade", "tela", "rascunhos", "previews", "evidenciasMcp"], "properties": { "modalidade": { "type": "string" }, "tela": { "type": "string" }, "rascunhos": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artefato" } }, "previews": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artefato" } }, "evidenciasMcp": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artefato" } } } } },
    "componentesLocais": { "$ref": "#/$defs/artefato" },
    "planoVariaveis": { "$ref": "#/$defs/artefato" },
    "evidenciasMcp": { "type": "array", "items": { "$ref": "#/$defs/artefato" } }
  },
  "$defs": {
    "artefato": {
      "type": "object",
      "required": ["id", "caminho", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "caminho": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
