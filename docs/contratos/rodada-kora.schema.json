{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Estado governado de uma rodada Kora",
  "type": "object",
  "required": ["schemaVersion", "rodada", "tipoRodada", "status", "entrada", "escopo", "checkpoints", "aprovacoes", "tentativas", "recibos", "artefatos", "pacotes", "pacotesPorModalidade", "decisoes", "bloqueios", "historico"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "rodada": { "type": "string", "minLength": 1 },
    "tipoRodada": { "enum": ["MOMENTO", "COMPOSICAO_ETAPA"] },
    "status": {
      "enum": [
        "PREPARANDO",
        "ANALISANDO",
        "AGUARDANDO_APROVACAO_CONTRATO",
        "MONTANDO",
        "VALIDANDO",
        "AGUARDANDO_APROVACAO_PROMOCAO",
        "PROMOVENDO",
        "CONCLUIDA",
        "AGUARDANDO_DECISAO_DO_DESIGNER",
        "BLOQUEADA",
        "INTERROMPIDA"
      ]
    },
    "entrada": {
      "type": "object",
      "required": ["figmaUrl", "sections", "contextoCurto", "etapa", "momento", "modalidades", "telas"],
      "properties": {
        "figmaUrl": { "type": "string", "minLength": 1 },
        "sections": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "contextoCurto": { "type": ["string", "null"] },
        "etapa": { "type": "string", "minLength": 1 },
        "momento": { "type": "string", "minLength": 1 },
        "modalidades": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
        "telas": { "type": "array", "items": { "type": "object" } }
      }
    },
    "escopo": { "type": "object", "required": ["arquivo", "sha256"], "properties": { "arquivo": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } },
    "checkpoints": {
      "type": "object",
      "required": ["analise", "contrato", "montagem", "validacao", "promocao"],
      "properties": {
        "analise": {
          "type": "object",
          "required": ["status", "gatePreProposta", "reconciliada"],
          "properties": {
            "status": { "enum": ["PENDENTE", "EM_ANDAMENTO", "APROVADA"] },
            "gatePreProposta": { "type": "boolean" },
            "reconciliada": { "type": "boolean" }
          }
        },
        "contrato": { "type": "object", "required": ["status"], "properties": { "status": { "enum": ["PENDENTE", "AGUARDANDO_APROVACAO", "APROVADO"] } } },
        "montagem": { "type": "object", "required": ["status"], "properties": { "status": { "enum": ["PENDENTE", "EM_ANDAMENTO", "CONCLUIDA"] } } },
        "validacao": { "type": "object", "required": ["status"], "properties": { "status": { "enum": ["PENDENTE", "EM_ANDAMENTO", "FAVORAVEL", "DESFAVORAVEL"] } } },
        "promocao": { "type": "object", "required": ["status"], "properties": { "status": { "enum": ["PENDENTE", "AGUARDANDO_APROVACAO", "APROVADA", "CONCLUIDA"] } } }
      }
    },
    "aprovacoes": {
      "type": "object",
      "required": ["contrato", "promocao"],
      "properties": {
        "contrato": { "$ref": "#/$defs/aprovacao" },
        "promocao": { "$ref": "#/$defs/aprovacao" }
      }
    },
    "tentativas": { "type": "array", "items": { "$ref": "#/$defs/tentativa" } },
    "recibos": { "type": "array", "items": { "$ref": "#/$defs/recibo" } },
    "artefatos": { "type": "array", "items": { "$ref": "#/$defs/artefato" } },
    "pacotes": { "$ref": "#/$defs/pacotes" },
    "pacotesPorModalidade": { "type": "object", "additionalProperties": { "$ref": "#/$defs/pacotes" } },
    "decisoes": { "type": "array", "items": { "$ref": "#/$defs/decisao" } },
    "bloqueios": { "type": "array", "items": { "$ref": "#/$defs/bloqueio" } },
    "incidenteOperacao": { "$ref": "#/$defs/incidenteOperacao" },
    "motivoInterrupcao": { "type": ["string", "null"] },
    "historico": { "type": "array", "items": { "$ref": "#/$defs/transicao" } }
  },
  "allOf": [
    {
      "if": { "properties": { "tipoRodada": { "const": "MOMENTO" } } },
      "then": { "properties": { "entrada": { "properties": { "sections": { "minItems": 1 }, "telas": { "minItems": 1 } } } } }
    },
    {
      "if": { "properties": { "tipoRodada": { "const": "COMPOSICAO_ETAPA" } } },
      "then": { "properties": { "entrada": { "properties": { "sections": { "maxItems": 0 }, "telas": { "maxItems": 0 }, "modalidades": { "minItems": 1, "maxItems": 1 } } } } }
    }
  ],
  "$defs": {
    "aprovacao": {
      "type": ["object", "null"],
      "required": ["tipo", "decisao", "confirmadoPor", "ocorreuEm"],
      "properties": {
        "tipo": { "enum": ["CONTRATO", "PROMOCAO"] },
        "decisao": { "const": "APROVADA" },
        "confirmadoPor": { "const": "DESIGNER" },
        "ocorreuEm": { "type": "string", "format": "date-time" }
      }
    },
    "tentativa": {
      "type": "object",
      "required": ["agente", "causa", "acao", "evidencia", "resultado", "ocorreuEm"],
      "properties": {
        "agente": { "type": "string", "minLength": 1 },
        "causa": { "type": "string", "minLength": 1 },
        "acao": { "type": "string", "minLength": 1 },
        "evidencia": { "type": "string", "minLength": 1 },
        "resultado": { "enum": ["FALHOU", "SUCESSO"] },
        "ocorreuEm": { "type": "string", "format": "date-time" }
      }
    },
    "recibo": {
      "type": "object",
      "required": ["papel", "checkpoint", "resultado", "evidencia", "ocorreuEm"],
      "properties": {
        "papel": { "enum": ["ANALISTA", "MONTADOR", "VALIDADOR", "OPERADOR", "REGISTRADOR"] },
        "checkpoint": { "enum": ["ANALISE", "MONTAGEM", "VALIDACAO", "PROMOCAO", "AUDITORIA"] },
        "resultado": { "enum": ["FAVORAVEL", "DESFAVORAVEL", "LIMITADA"] },
        "evidencia": { "type": "string", "minLength": 1 },
        "ocorreuEm": { "type": "string", "format": "date-time" }
      }
    },
    "artefato": {
      "type": "object",
      "required": ["id", "caminho", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "caminho": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "decisao": {
      "type": "object",
      "required": ["id", "pergunta", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "pergunta": { "type": "string", "minLength": 1 },
        "status": { "enum": ["PENDENTE", "RESPONDIDA"] },
        "resposta": { "type": ["string", "null"] },
        "respondidaEm": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "bloqueio": {
      "type": "object",
      "required": ["codigo", "mensagem", "proximaAcao"],
      "properties": {
        "codigo": { "type": "string", "minLength": 1 },
        "mensagem": { "type": "string", "minLength": 1 },
        "proximaAcao": { "type": "string", "minLength": 1 }
      }
    },
    "incidenteOperacao": {
      "type": ["object", "null"],
      "required": ["id", "classificacao", "fase", "papel", "impacto", "versaoBase", "pontoRetomada", "status", "criadoEm"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "classificacao": { "const": "INCIDENTE_DA_OPERACAO" },
        "fase": { "enum": ["ANALISE", "MONTAGEM", "VALIDACAO", "PROMOCAO", "ORQUESTRACAO"] },
        "papel": { "enum": ["KORA", "ANALISTA", "MONTADOR", "VALIDADOR", "OPERADOR", "REGISTRADOR"] },
        "impacto": { "const": "BLOQUEIA_RODADA" },
        "versaoBase": { "type": ["string", "null"] },
        "pontoRetomada": { "enum": ["ANALISANDO", "MONTANDO", "VALIDANDO", "AGUARDANDO_APROVACAO_PROMOCAO"] },
        "status": { "enum": ["ABERTO", "RETOMADO"] },
        "criadoEm": { "type": "string", "format": "date-time" },
        "retomadoEm": { "type": ["string", "null"], "format": "date-time" },
        "correcaoCommit": { "type": ["string", "null"] }
      }
    },
    "pacote": {
      "type": ["object", "null"],
      "required": ["arquivo", "sha256", "estado"],
      "properties": {
        "arquivo": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "estado": { "type": "string", "minLength": 1 }
      }
    },
    "pacotes": {
      "type": "object",
      "required": ["analista", "montagem", "veredito", "promocao"],
      "properties": {
        "analista": { "$ref": "#/$defs/pacote" },
        "montagem": { "$ref": "#/$defs/pacote" },
        "veredito": { "$ref": "#/$defs/pacote" },
        "promocao": { "$ref": "#/$defs/pacote" }
      }
    },
    "transicao": {
      "type": "object",
      "required": ["de", "para", "ocorreuEm"],
      "properties": {
        "de": { "type": "string", "minLength": 1 },
        "para": { "type": "string", "minLength": 1 },
        "ocorreuEm": { "type": "string", "format": "date-time" },
        "motivo": { "type": ["string", "null"] }
      }
    }
  }
}
