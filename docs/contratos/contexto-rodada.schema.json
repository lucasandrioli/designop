{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rascunho temporario de contexto de rodada",
  "type": "object",
  "required": ["schemaVersion", "id", "rodada", "status", "modalidade", "etapa", "contextos", "afirmacoes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "rodada": { "type": "string", "minLength": 1 },
    "status": { "enum": ["RASCUNHO", "AGUARDANDO_DESIGNER", "PRONTO_PARA_APROVACAO", "APROVADO_PARA_REGISTRO"] },
    "modalidade": { "type": "string", "minLength": 1 },
    "etapa": { "type": "string", "minLength": 1 },
    "contextos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "pattern": "^ctx-[a-z0-9-]+$" },
          "rotulo": { "type": ["string", "null"] }
        }
      }
    },
    "afirmacoes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "escopo", "categoria", "classificacao", "texto", "fonte", "bloqueante"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "escopo": { "enum": ["GLOBAL", "MODALIDADE", "ETAPA", "CONTEXTO"] },
          "contextoId": { "type": ["string", "null"], "pattern": "^ctx-[a-z0-9-]+$" },
          "categoria": { "enum": ["TOPOLOGIA_OBSERVADA", "INTERACAO_OBSERVADA", "SINAL_TECNICO", "REGRA_NEGOCIO", "PRESENCA_COMPOSICAO", "RETORNO_APP", "ROTEIRO_ORIENTACAO", "OUTRA"] },
          "classificacao": { "enum": ["FATO_OBSERVADO", "REGRA_DOCUMENTADA", "REGRA_CONFIRMADA", "CONFIRMAR"] },
          "texto": { "type": "string", "minLength": 1 },
          "valorControlado": { "enum": ["DIRETO", "ACAO_NO_APP", "DIRETA", "DIRETA_COM_TUTORIAL_OPCIONAL", "PRESENTE_OBRIGATORIA", "AUSENTE_OBRIGATORIA", null] },
          "bloqueante": { "type": "boolean" },
          "fonte": {
            "type": "object",
            "required": ["tipo"],
            "properties": {
              "tipo": { "enum": ["FIGMA", "DOCUMENTO", "DESIGNER", "AUSENTE"] },
              "referencias": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["section"],
                  "properties": {
                    "section": { "type": "string", "minLength": 1 },
                    "nodeId": { "type": ["string", "null"] }
                  }
                }
              },
              "documento": { "type": ["string", "null"] },
              "registroHumano": { "type": ["string", "null"] },
              "motivo": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "aprovacaoHumana": {
      "type": ["object", "null"],
      "properties": {
        "registro": { "type": "string", "minLength": 1 }
      }
    }
  }
}
