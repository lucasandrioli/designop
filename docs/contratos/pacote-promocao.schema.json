{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Recibo de promocao concluida",
  "type": "object",
  "required": ["schemaVersion", "rodada", "emitidoEm", "aprovacaoKora", "veredito", "validacaoPromocao", "ativosPublicados", "releiturasPosPromocao"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "rodada": { "type": "string", "minLength": 1 },
    "emitidoEm": { "type": "string", "format": "date-time" },
    "aprovacaoKora": { "$ref": "#/$defs/artefato" },
    "veredito": { "$ref": "#/$defs/artefato" },
    "validacaoPromocao": {
      "type": "object",
      "required": ["origem", "resultado", "artefato", "executadaEm"],
      "properties": {
        "origem": { "const": "VALIDATE_PROMOTION" },
        "resultado": { "const": "FAVORAVEL" },
        "artefato": { "$ref": "#/$defs/artefato" },
        "executadaEm": { "type": "string", "format": "date-time" }
      }
    },
    "ativosPublicados": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["template", "nome", "tipo", "resultado"],
        "properties": {
          "template": { "type": "string", "minLength": 1 },
          "nome": { "type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+/tpl-[a-z0-9-]+$" },
          "tipo": { "enum": ["COMPONENT", "COMPONENT_SET"] },
          "resultado": { "const": "FAVORAVEL" }
        }
      }
    },
    "contextosProibidosNoNome": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "releiturasPosPromocao": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["template", "resultado", "artefato", "executadaEm"],
        "properties": {
          "template": { "type": "string", "minLength": 1 },
          "resultado": { "const": "FAVORAVEL" },
          "artefato": { "$ref": "#/$defs/artefato" },
          "executadaEm": { "type": "string", "format": "date-time" }
        }
      }
    }
  },
  "$defs": {
    "artefato": {
      "type": "object",
      "required": ["caminho", "sha256"],
      "properties": {
        "caminho": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
