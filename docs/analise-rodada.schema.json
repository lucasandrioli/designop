{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Manifesto temporario de analise de etapa",
  "type": "object",
  "required": ["schemaVersion", "id", "etapa", "status", "fontes", "inventario", "execucoesColeta", "coberturaReacoes", "coberturaEstrutura", "reacoes", "diferencas", "lacunas"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "id": { "type": "string", "minLength": 1 },
    "etapa": { "type": "string", "minLength": 1 },
    "status": { "enum": ["PRECISA_CONTEXTO", "ANALISE_INCOMPLETA", "PROPOSTA_PARA_APROVACAO"] },
    "fontes": {
      "type": "object",
      "required": ["figma", "documentos"],
      "properties": {
        "figma": {
          "type": "object",
          "required": ["pagina", "secoesReferencia"],
          "properties": {
            "pagina": { "type": "string", "minLength": 1 },
            "secoesReferencia": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["nome", "nodeId", "contextoId"],
                "properties": {
                  "nome": { "type": "string", "minLength": 1 },
                  "nodeId": { "type": "string", "minLength": 1 },
                  "contextoId": { "type": "string", "pattern": "^ctx-[a-z0-9-]+$" }
                }
              }
            }
          }
        },
        "documentos": {
          "type": "object",
          "required": ["manualGlobal", "mapa", "manuaisContexto"],
          "properties": {
            "manualGlobal": { "type": ["string", "null"] },
            "mapa": { "type": ["string", "null"] },
            "manuaisContexto": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "inventario": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tela", "modalidade", "contextoId", "frame", "evidencia"],
        "properties": {
          "tela": { "type": "string", "minLength": 1 },
          "modalidade": { "type": "string", "minLength": 1 },
          "contextoId": { "type": "string", "pattern": "^ctx-[a-z0-9-]+$" },
          "frame": { "type": "object", "required": ["nome", "nodeId"] },
          "evidencia": { "type": "object", "required": ["screenshot", "designContext"] }
        }
      }
    },
    "execucoesColeta": {
      "description": "Registro unitario de cada coleta feita no Figma. Uma execucao nao combina coletores, Sections ou partes.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["coletor", "secao", "nodeId", "parte"],
        "properties": {
          "coletor": { "enum": ["scripts/collectPrototypeReactions.js", "scripts/collectReferenceStructure.js"] },
          "secao": { "type": "string", "minLength": 1 },
          "nodeId": { "type": "string", "minLength": 1 },
          "parte": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "coberturaReacoes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["secao", "nodeId", "nodesInspecionados", "nodesComReacao", "coletor", "status", "totalPartes", "pageSize", "totalItens", "itensPorParte", "partesLidas"],
        "properties": {
          "secao": { "type": "string", "minLength": 1 },
          "nodeId": { "type": "string", "minLength": 1 },
          "nodesInspecionados": { "type": "integer", "minimum": 1 },
          "nodesComReacao": { "type": "integer", "minimum": 0 },
          "totalPartes": { "type": "integer", "minimum": 1 },
          "pageSize": { "type": "integer", "minimum": 1 },
          "totalItens": { "type": "integer", "minimum": 0 },
          "itensPorParte": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 1 },
          "partesLidas": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 1 },
          "coletor": { "const": "scripts/collectPrototypeReactions.js" },
          "status": { "enum": ["COBERTA", "FALHOU"] }
        }
      }
    },
    "coberturaEstrutura": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["secao", "nodeId", "nodesInspecionados", "coletor", "status", "totalPartes", "pageSize", "totalItens", "itensPorParte", "partesLidas"],
        "properties": {
          "secao": { "type": "string", "minLength": 1 },
          "nodeId": { "type": "string", "minLength": 1 },
          "nodesInspecionados": { "type": "integer", "minimum": 1 },
          "totalPartes": { "type": "integer", "minimum": 1 },
          "pageSize": { "type": "integer", "minimum": 1 },
          "totalItens": { "type": "integer", "minimum": 0 },
          "itensPorParte": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 1 },
          "partesLidas": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 1 },
          "coletor": { "const": "scripts/collectReferenceStructure.js" },
          "status": { "enum": ["COBERTA", "FALHOU"] }
        }
      }
    },
    "reacoes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["origem", "gatilho", "target", "tipo", "fonte", "status"],
        "properties": {
          "origem": { "type": "object", "required": ["nodeId", "nome"] },
          "gatilho": { "type": ["object", "string"] },
          "target": {
            "type": ["object", "null"],
            "properties": {
              "kind": { "enum": ["NODE", "URL", "BACK", "CLOSE", "UNKNOWN"] },
              "node": { "type": ["object", "null"] },
              "url": { "type": ["string", "null"] }
            }
          },
          "tipo": { "enum": ["PRINCIPAL", "OPCIONAL", "RETORNO", "EXCECAO", "REENCONTRO"] },
          "fonte": { "enum": ["FIGMA", "DESIGNER", "NAO_EXPOSTA"] },
          "status": { "enum": ["OBSERVADA", "SEM_REACAO_OBSERVADA", "NAO_VERIFICADA_NESTA_RODADA"] }
        }
      }
    },
    "diferencas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tela", "tipo", "contextoIds", "origemRegra", "regraDocumentada", "confirmar"],
        "properties": {
          "tela": { "type": "string" },
          "tipo": { "type": "string" },
          "contextoIds": { "type": "array", "items": { "type": "string", "pattern": "^ctx-[a-z0-9-]+$" } },
          "origemRegra": { "enum": ["global", "convenio", "[CONFIRMAR]"] },
          "regraDocumentada": { "type": ["string", "null"] },
          "confirmar": { "type": "boolean" }
        }
      }
    },
    "verificacoesTecnicas": {
      "description": "Classificacao de uma regra tecnica explicitamente declarada para a rodada. Ausencia de escopo nunca vira violacao.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["regraId", "aplicacao", "status"],
        "properties": {
          "regraId": { "type": "string", "minLength": 1 },
          "aplicacao": {
            "type": "object",
            "required": ["secoesReferencia"],
            "properties": {
              "secoesReferencia": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 },
                "uniqueItems": true
              }
            }
          },
          "status": { "enum": ["ATENDIDA", "VIOLADA", "NAO_APLICAVEL", "NAO_VERIFICAVEL"] },
          "evidencias": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "lacunas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "bloqueante", "motivo"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "bloqueante": { "type": "boolean" },
          "motivo": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
