{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plano temporario de variaveis da analise",
  "description": "Proposta logica, sem criar collections, modes, bindings ou variaveis no Figma.",
  "type": "object",
  "required": ["schemaVersion", "id", "rodada", "status", "modalidade", "etapa", "collections", "variaveis"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "rodada": { "type": "string", "minLength": 1 },
    "status": { "const": "PROPOSTO" },
    "modalidade": { "type": "string", "minLength": 1 },
    "etapa": { "type": "string", "minLength": 1 },
    "collections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "papel"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "papel": { "enum": ["CONTEUDO_MODALIDADE", "ESTRUTURAL_IDS"] }
        }
      }
    },
    "variaveis": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["papel", "caminho"],
        "properties": {
          "papel": { "type": "string", "minLength": 1 },
          "caminho": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
