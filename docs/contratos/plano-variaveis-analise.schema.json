{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plano temporario de variaveis da analise",
  "description": "Proposta logica, sem criar collections, modes, bindings ou variaveis no Figma.",
  "type": "object",
  "required": ["schemaVersion", "id", "rodada", "status", "etapa", "momento", "modalidades", "diferencasEstruturais", "conexoes"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "id": { "type": "string", "minLength": 1 },
    "rodada": { "type": "string", "minLength": 1 },
    "status": { "const": "PROPOSTO" },
    "etapa": { "type": "string", "minLength": 1 },
    "momento": { "type": "string", "minLength": 1 },
    "modalidades": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "collectionConteudo", "variaveis"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "collectionConteudo": { "type": "string", "minLength": 1 },
          "variaveis": { "type": "array", "items": { "type": "object", "required": ["tela", "papel", "caminho", "tipo"], "properties": { "tela": { "type": "string" }, "papel": { "type": "string" }, "caminho": { "type": "string" }, "tipo": { "const": "CONTEUDO" }, "mecanismo": { "enum": ["VARIAVEL", "PROPERTY", "VARIANT", "ESPECIALIZACAO"] } } } }
        }
      }
    },
    "diferencasEstruturais": { "type": "array", "items": { "type": "object" } },
    "conexoes": { "type": "array", "items": { "type": "object" } }
  }
}
