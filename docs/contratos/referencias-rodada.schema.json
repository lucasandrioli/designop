{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Recorte temporario de referencias Figma",
  "type": "object",
  "required": ["schemaVersion", "id", "rodada", "figma", "ativosForaDoRecorte", "ativosExistentes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "rodada": { "type": "string", "minLength": 1 },
    "figma": {
      "type": "object",
      "required": ["pageId", "pageName", "secoes"],
      "properties": {
        "pageId": { "type": "string", "minLength": 1 },
        "pageName": { "type": "string", "minLength": 1 },
        "secoes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["nome", "sectionId", "contextoId"],
            "properties": {
              "nome": { "type": "string", "pattern": "^ref-" },
              "sectionId": { "type": "string", "minLength": 1 },
              "contextoId": { "type": "string", "pattern": "^ctx-[a-z0-9-]+$" }
            }
          }
        }
      }
    },
    "ativosForaDoRecorte": { "const": "IGNORAR" },
    "ativosExistentes": {
      "type": "object",
      "required": ["politica", "adocaoAutomatica"],
      "properties": {
        "politica": { "const": "EVIDENCIA_APENAS" },
        "adocaoAutomatica": { "const": false }
      }
    }
  }
}
