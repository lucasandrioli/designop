{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contrato logico de jornada",
  "type": "object",
  "required": ["schemaVersion", "id", "modalidade", "collectionConteudo", "contextos", "selecoes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "modalidade": { "type": "string", "minLength": 1 },
    "collectionConteudo": { "type": "string", "minLength": 1 },
    "contextos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "mode"],
        "properties": {
          "id": { "type": "string", "pattern": "^ctx-[a-z0-9-]+$" },
          "mode": { "type": "string", "minLength": 1 }
        }
      }
    },
    "selecoes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["contextoId", "tela", "casoUso", "presente"],
        "properties": {
          "contextoId": { "type": "string", "pattern": "^ctx-[a-z0-9-]+$" },
          "tela": { "type": "string", "minLength": 1 },
          "casoUso": { "type": "string", "minLength": 1 },
          "presente": { "type": "boolean" },
          "template": { "type": ["string", "null"] },
          "origemRegra": { "enum": ["global", "convenio", "[CONFIRMAR]"] }
        }
      }
    },
    "composicoesInternas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "contextoId", "etapaHospedeira", "presente", "origemRegra"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "contextoId": { "type": "string", "pattern": "^ctx-[a-z0-9-]+$" },
          "etapaHospedeira": { "type": "string", "minLength": 1 },
          "presente": { "type": "boolean" },
          "orientacao": { "enum": ["DIRETA", "DIRETA_COM_TUTORIAL_OPCIONAL", "[CONFIRMAR]"] },
          "retorno": { "enum": ["DIRETO", "ACAO_NO_APP", "[CONFIRMAR]"] },
          "origemRegra": { "enum": ["global", "convenio", "[CONFIRMAR]"] }
        },
        "allOf": [
          {
            "if": { "properties": { "presente": { "const": true } } },
            "then": { "required": ["orientacao", "retorno"] }
          },
          {
            "if": { "properties": { "presente": { "const": false } } },
            "then": { "not": { "anyOf": [{ "required": ["orientacao"] }, { "required": ["retorno"] }] } }
          }
        ]
      }
    },
    "documentos": {
      "type": "object",
      "properties": {
        "manualGlobal": { "type": "string", "minLength": 1 },
        "manualModalidade": { "type": "string", "minLength": 1 },
        "mapa": { "type": "string", "minLength": 1 }
      }
    }
  }
}
